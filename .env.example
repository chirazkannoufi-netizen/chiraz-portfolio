# ─────────────────────────────────────────────────────────────
#  SITE
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://chiraz.dev"

# ─────────────────────────────────────────────────────────────
#  AI — CV Chatbot Agent  (server-only, never expose)
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-..."
# Swap the model without touching code. gpt-4o-mini class is plenty for a
# grounded, short-answer CV agent and keeps cost near zero.
AI_MODEL="gpt-4o-mini"

# ─────────────────────────────────────────────────────────────
#  CLOUDFLARE TURNSTILE — anti-bot on the contact form
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAA..."
TURNSTILE_SECRET_KEY="0x4AAAAAAA..."

# ─────────────────────────────────────────────────────────────
#  n8n — contact form fan-out (Telegram + email + Supabase row)
#
#  ⚠️ This must be the Webhook node's *Production URL*, not the address bar
#  of the n8n editor. The editor URL looks like
#      http://localhost:5678/workflow/<workflow-id>      ← WRONG, returns 404
#  the webhook looks like
#      https://n8n.yourdomain.com/webhook/<path>         ← right
#  The workflow also has to be Active, or the production path isn't
#  registered and every POST 404s.
#
#  ⚠️ It must be reachable from wherever the site runs. A localhost n8n is
#  fine in development, but a deployed site cannot call your laptop — use a
#  public URL (or a tunnel) in production.
# ─────────────────────────────────────────────────────────────
N8N_WEBHOOK_URL="https://n8n.yourdomain.com/webhook/portfolio-contact"
# Shared secret sent as `x-portfolio-signature`, raw and as-is — NOT an HMAC.
# The n8n workflow compares this header against the same value and stops if
# it differs, so leaking the webhook URL alone can't inject fake leads.
N8N_WEBHOOK_SECRET="change-me-to-a-long-random-string"

# ─────────────────────────────────────────────────────────────
#  SMTP — fallback for the contact form
#
#  Only used when the n8n webhook is unset, unreachable, or errors. Without
#  it a delivery failure means the lead is lost, so this is worth setting
#  even if n8n is healthy.
# ─────────────────────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@example.com"
# Gmail requires an App Password here, not your account password.
SMTP_PASS=""
# Optional. Defaults to SMTP_USER / the address in content/profile.ts.
SMTP_FROM=""
CONTACT_TO=""

# ─────────────────────────────────────────────────────────────
#  NOT USED BY THE SITE
#
#  Supabase is written to by the n8n workflow, server-side. The site itself
#  contains no Supabase client, so it needs no Supabase URL or key — and a
#  NEXT_PUBLIC_* variable is inlined into the browser bundle, so adding one
#  would publish it to every visitor for no benefit. Keep Supabase
#  credentials in n8n only.
# ─────────────────────────────────────────────────────────────

